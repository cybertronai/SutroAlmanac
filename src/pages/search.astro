---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<Layout title="Search · Sutro Almanac" description="Search every page of the Sutro Almanac.">
  <link slot="head" rel="stylesheet" href={`${base}pagefind/pagefind-ui.css`} />
  <article class="sy-search">
    <div class="bg"></div>
    <div class="u-container">
      <h1 class="u-heading title" data-sy-reveal="words">Search</h1>
      <p class="u-text hint">
        Searches every page of the record: recaps, meetings, challenges, and the
        reference pages.
      </p>
      <div id="search"></div>
    </div>
  </article>
</Layout>

<script is:inline define:vars={{ base }}>
  const boot = () => {
    const el = document.getElementById("search");
    const s = document.createElement("script");
    s.src = base + "pagefind/pagefind-ui.js";
    s.onload = () => {
      new PagefindUI({ element: "#search", showSubResults: true, showImages: false });
      const input = el.querySelector("input");
      if (input) input.focus();
    };
    s.onerror = () => {
      el.textContent =
        "The search index is generated by the production build. Run npm run build; the dev server does not have it.";
    };
    document.head.appendChild(s);
  };
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }
</script>

<style>
  .sy-search {
    position: relative;
    z-index: 1;
    padding: 9rem 0 8rem;
    min-height: 80vh;
  }

  .bg {
    position: absolute;
    inset: 0 0 auto;
    height: 28rem;
    z-index: -1;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(236, 231, 253, 0.5) 0%, rgba(255, 237, 220, 0.22) 45%, transparent 100%),
      radial-gradient(60% 80% at 88% 0%, rgba(255, 79, 163, 0.16), transparent 60%),
      radial-gradient(50% 80% at -5% 0%, rgba(141, 115, 245, 0.16), transparent 60%);
    mask: linear-gradient(180deg, #000 60%, transparent 100%);
  }

  .title {
    --fs: 3.25rem;
    --lh: 1;
  }

  .hint {
    --fs: var(--font-size-lg);
    color: var(--color-text-alt);
    max-width: 40em;
    margin: 1.25rem 0 2rem;
  }

  #search {
    max-width: 46rem;
    --pagefind-ui-primary: var(--color-brand-1);
    --pagefind-ui-text: var(--color-text);
    --pagefind-ui-background: rgba(255, 255, 255, 0.6);
    --pagefind-ui-border: rgba(11, 31, 91, 0.15);
    --pagefind-ui-border-radius: 0.9rem;
    --pagefind-ui-font: var(--font-inter);
  }
</style>
